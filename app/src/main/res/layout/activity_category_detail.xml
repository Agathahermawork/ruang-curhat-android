<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_calming_gradient">

    <RelativeLayout
        android:id="@+id/headerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:outlineProvider="bounds">

        <ImageButton
            android:id="@+id/btnBackFromCategory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_btn_dark"
            android:backgroundTint="#52B788"
            android:src="@drawable/ic_back_white"
            android:contentDescription="Kembali"
            android:elevation="0dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/btnBackFromCategory"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bimbingan Mental"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="-0.01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Pembimbing Rohani Terpercaya Instansi"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.01"/>
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCategory"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/layoutConsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

        </LinearLayout>
    </ScrollView>

</RelativeLayout>