<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_calming_gradient"> <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="20dp"
    android:background="#FFFFFF"
    android:elevation="4dp"
    android:outlineProvider="bounds">

    <ImageButton
        android:id="@+id/btnBackFromDev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_btn_dark"
        android:backgroundTint="#52B788"
        android:src="@drawable/ic_back_white"
        android:scaleType="centerInside"
        android:elevation="0dp"
        android:contentDescription="Kembali"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/btnBackFromDev"
        android:layout_marginStart="16dp"
        android:layout_centerVertical="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel Kontrol Pengembang"
            android:textColor="#000000"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="-0.01"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pusat Manajemen Database Lintas Agama"
            android:textColor="#52B788"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daftarkan Konselor Baru"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KATEGORI AGAMA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <Spinner
                        android:id="@+id/spinnerReligion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAMA LENGKAP &amp; GELAR"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevConsName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PANGKAT"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="8dp"/>
                            <EditText
                                android:id="@+id/etDevConsRank"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input_rounded"
                                android:backgroundTint="#F8FAFC"
                                android:paddingHorizontal="16dp"
                                android:textColor="#000000"
                                android:inputType="textCapWords"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NRP / NIP"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="8dp"/>
                            <EditText
                                android:id="@+id/etDevConsNrp"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input_rounded"
                                android:backgroundTint="#F8FAFC"
                                android:paddingHorizontal="16dp"
                                android:textColor="#000000"
                                android:inputType="number"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JABATAN DINAS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevConsJob"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textColor="#000000"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KESATUAN / UNIT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevConsUnit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textColor="#000000"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID TELEGRAM"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevConsTelegram"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textColor="#000000"
                        android:inputType="phone"
                        android:textSize="14sp"
                        android:layout_marginBottom="28dp"
                        android:textColorHint="#C7C7CC"
                        android:hint="+62..."/>

                    <Button
                        android:id="@+id/btnRegisterNewCounselor"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Simpan &amp; Daftarkan"
                        android:backgroundTint="#52B788"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:elevation="0dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah Akun Anggota"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL AKUN DINAS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevUserEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="20dp"
                        android:textColorHint="#C7C7CC"
                        android:hint="nama@dinas.com"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD AKUN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevUserPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:inputType="textPassword"
                        android:layout_marginBottom="20dp"
                        android:textColorHint="#C7C7CC"
                        android:hint="Minimal 6 karakter"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAMA ANGGOTA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etDevUserName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="20dp"
                        android:textColorHint="#C7C7CC"
                        android:hint="Nama lengkap prajurit..."/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="28dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PANGKAT"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="8dp"/>
                            <EditText
                                android:id="@+id/etDevUserRank"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input_rounded"
                                android:backgroundTint="#F8FAFC"
                                android:paddingHorizontal="16dp"
                                android:textColor="#000000"
                                android:inputType="textCapWords"
                                android:textSize="14sp"
                                android:textColorHint="#C7C7CC"
                                android:hint="LETDA"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NRP / NIP"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="8dp"/>
                            <EditText
                                android:id="@+id/etDevUserNrp"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_input_rounded"
                                android:backgroundTint="#F8FAFC"
                                android:paddingHorizontal="16dp"
                                android:textColor="#000000"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:textColorHint="#C7C7CC"
                                android:hint="5430..."/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRegisterNewUser"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Aktifkan Anggota"
                        android:backgroundTint="#52B788"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:elevation="0dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelola Konselor Terdaftar"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/layoutDevConsListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true">
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
