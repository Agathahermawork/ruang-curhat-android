<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"> <!-- Warna dasar background halaman biar kontras -->

    <!-- Header Dev Panel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="#0F172A">

        <ImageButton
            android:id="@+id/btnBackFromDev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_dark"
            android:src="@drawable/ic_back_white"
            android:contentDescription="Kembali"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/btnBackFromDev"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"> <!-- Ditambah agar teks sejajar vertikal dengan tombol back -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel Kontrol Pengembang"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pusat Manajemen Database Lintas Agama"
                android:textColor="#94A3B8"
                android:textSize="10sp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Forms -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"> <!-- Menjamin scrollview mengisi sisa layar dengan benar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CARD 1: FORMULIR PENDAFTARAN KONSELOR BARU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sub_premium"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👳‍♂️ Daftarkan Konselor Baru"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="16dp"/>

                <!-- Spinner Agama -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KATEGORI AGAMA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <Spinner
                    android:id="@+id/spinnerReligion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="16dp"/>

                <!-- Nama Lengkap -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAMA LENGKAP &amp; GELAR"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevConsName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="16dp"/>

                <!-- Grid Pangkat & NRP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PANGKAT"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etDevConsRank"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:paddingHorizontal="12dp"
                            android:textColor="#0F172A"
                            android:inputType="textCapWords"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NRP / NIP"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etDevConsNrp"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:paddingHorizontal="12dp"
                            android:textColor="#0F172A"
                            android:inputType="number"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Jabatan Dinas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JABATAN DINAS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevConsJob"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textColor="#0F172A"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Kesatuan Kerja -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KESATUAN / UNIT"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevConsUnit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textColor="#0F172A"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <!-- No Telegram -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID TELEGRAM"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevConsTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textColor="#0F172A"
                    android:inputType="text"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp"
                    android:hint="+62..."/>

                <Button
                    android:id="@+id/btnRegisterNewCounselor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Simpan &amp; Daftarkan Konselor"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- CARD 2: FORMULIR TAMBAH AKUN ANGGOTA BARU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sub_premium"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Tambah Akun Anggota Dinas Baru"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="16dp"/>

                <!-- Email Dinas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL AKUN DINAS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp"
                    android:hint="nama@gmail.com"/>

                <!-- Nama Lengkap -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAMA ANGGOTA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etDevUserName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="16dp"
                    android:hint="Nama lengkap prajurit..."/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PANGKAT"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etDevUserRank"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:paddingHorizontal="12dp"
                            android:textColor="#0F172A"
                            android:inputType="textCapWords"
                            android:textSize="12sp"
                            android:hint="LETDA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NRP / NIP"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etDevUserNrp"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:paddingHorizontal="12dp"
                            android:textColor="#0F172A"
                            android:inputType="number"
                            android:textSize="12sp"
                            android:hint="5430..."/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnRegisterNewUser"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Tambah &amp; Aktifkan Anggota"
                    android:backgroundTint="#0F172A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- CARD 3: DAFTAR KELOLA & HAPUS KONSELOR AKTIF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sub_premium"
                android:padding="20dp"
                android:layout_marginBottom="16dp"> <!-- Ditambahkan margin bottom agar tidak terlalu mepet bawah scroll -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Daftar &amp; Kelola Konselor Terdaftar"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="16dp"/>

                <!-- Container dinamis untuk menyuntikkan daftar ustadz -->
                <LinearLayout
                    android:id="@+id/layoutDevConsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Cards ditaruh disini via Kotlin -->
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>