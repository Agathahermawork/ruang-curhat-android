<?xml version="1.0" encoding="utf-8"?>
<!-- Pembungkus Utama (Parent) wajib ada di bagian luar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_sub_premium"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Bagian Atas: Foto/Emoji & Biodata Singkat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvConsEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge_secure"
            android:gravity="center"
            android:text="👳‍♂️"
            android:textSize="24sp"
            android:layout_marginEnd="16dp"
            tools:ignore="SubsamplingScaleImageView" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ustadz Name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>

            <TextView
                android:id="@+id/tvConsRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pangkat: MAYOR"
                android:textColor="#0284C7"
                android:textStyle="bold"
                android:textSize="9sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvConsNrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NRP: 5241029"
                android:textColor="#64748B"
                android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Garis Pembatas (Divider) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="12dp"/>

    <!-- Bagian Tengah: Jabatan & Kesatuan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvConsJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jabatan"
            android:textSize="11sp"
            android:textColor="#475569"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvConsUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kesatuan Kerja"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Bagian Bawah: Tombol Aksi Telegram -->
    <Button
        android:id="@+id/btnContactTelegram"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Hubungi Bintal via Telegram"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="false"/>

</LinearLayout>