<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_premium"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Profil Atas (Emoji & Identitas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Wadah Emoji -->
        <TextView
            android:id="@+id/tvConsEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge_secure"
            android:gravity="center"
            android:text="👳‍♂️"
            android:textSize="24sp"
            android:layout_marginEnd="16dp"/>

        <!-- Text Container yang Adaptif -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvConsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ustadz Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>
            <TextView
                android:id="@+id/tvConsRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pangkat: MAYOR"
                android:textColor="#0284C7"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
            <TextView
                android:id="@+id/tvConsNrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NRP: 5241029"
                android:textColor="#64748B"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Garis Divider Menengah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="12dp"/>

    <!-- Bagian Jabatan & Kesatuan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:id="@+id/tvConsJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jabatan"
            android:textSize="12sp"
            android:textColor="#475569"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvConsUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kesatuan Kerja"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Tombol Aksi Mandiri yang Kompatibel Berubah Warna Merah/Biru di DevPanelActivity -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContactTelegram"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Hubungi Bintal via Telegram"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"/>

</LinearLayout>